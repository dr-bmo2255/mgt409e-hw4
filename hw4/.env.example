# Campus Customs — environment variables (names only; never commit real values).
# The shop reads ../.env (one folder above this project) and then ./.env, if present.

# Portkey gateway key: all chat / design-agent calls go through Portkey.
PORTKEY_API_KEY=
# Signs the login session cookie. Use a long random string.
SESSION_SECRET=

# Optional settings (defaults shown)
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Custom Dan Gear image generation: "openai" (paid, needs OPENAI_API_KEY in ask-dan-image-studio/.env) or "mock" (free)
CUSTOM_IMAGE_PROVIDER=openai
CUSTOM_IMAGE_MODEL=gpt-image-2.5-sunburst
CUSTOM_USER_DAILY_LIMIT=3
CUSTOM_SITE_DAILY_BUDGET=3.00
# Set to 1 when the site is served over HTTPS
COOKIE_SECURE=0
