# Copy to .env (never commit it). One of these is enough.
# Direct OpenAI:
# OPENAI_API_KEY=sk-...
# Or the Portkey gateway used by the Campus Customs project (the studio also reads ../../.env):
# PORTKEY_API_KEY=...
# Optional: chat model for the studio's art director (same variable as the shop)
# OPENAI_MODEL=gpt-5.6-luna
